[Unit]
Description=Select MK3 operating mode at boot
Documentation=file:/opt/mpi-station/mode-selector/README.md
Wants=NetworkManager.service
After=local-fs.target NetworkManager.service
ConditionPathExists=/var/lib/mpi-station/provisioned

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/mk3-mode-selector --force-menu
TimeoutStartSec=infinity
